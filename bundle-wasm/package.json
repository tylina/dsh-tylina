{
  "name": "dsh-tylina",
  "version": "0.4.11",
  "type": "module",
  "license": "UNLICENSED",
  "description": "Tylina wasm runtime bundle for DeepSeek Harness",
  "exports": {
    "./package.json": "./package.json",
    ".": "./dist/index.js",
    "./client": "./dist/client.js"
  },
  "files": [
    "cordis.patch.yml",
    "dist"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-session": "0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.2-rc.1",
    "@deepseek-ai/dsh-skill-filesystem": "0.1.2-rc.1",
    "ws": "^8.18.3",
    "tylina-web-assets": "0.4.9"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "dsh-better-sidebar": "^0.18.0"
  },
  "devDependencies": {
    "@tylina/dsh-plugin": "workspace:*",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "bundle": "node ../build.mjs wasm"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tylina/dsh-tylina.git",
    "directory": "bundle-wasm"
  },
  "bugs": {
    "url": "https://github.com/tylina/dsh-tylina/issues"
  },
  "homepage": "https://github.com/tylina/dsh-tylina#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "dsh-better-sidebar": {
      "optional": true
    }
  }
}
